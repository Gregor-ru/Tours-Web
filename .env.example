# Скопируй в .env.local (локально) или задай в Vercel → Project → Settings → Environment Variables.
# Значения в репозиторий не коммитить.

# Токен бота от @BotFather, вида 1234567890:AA...
TELEGRAM_BOT_TOKEN=

# chat_id получателей заявок через запятую, без пробелов.
# Личка: положительное число (123456789). Группа: отрицательное (-1001234567890).
# Каждый получатель должен сначала написать боту /start (или бот должен быть добавлен в группу).
TELEGRAM_CHAT_IDS=

# Яндекс Метрика здесь не настраивается: номер счётчика (108713848) прописан в коде — src/lib/metrika.ts.

# Только для скрипта импорта отзывов (npm run review:add), на сайте не используется и в Vercel не нужен.
# Сервисный ключ приложения ВК: id.vk.com → твоё приложение → «Ключи доступа» → «Сервисный ключ».
VK_SERVICE_TOKEN=

# Админка фото (/admin). Пароль - длинный, только для тебя. Без него админка не открывается.
ADMIN_PASSWORD=
# Куда админка сохраняет фото: репозиторий GitHub и ветка, из которой Vercel собирает сайт.
# Токен - fine-grained, доступ только к этому репозиторию, права Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPO=Gregor-ru/Tours-Web
GITHUB_BRANCH=main
