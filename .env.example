# Скопируй в .env.local (локально) или задай в Vercel → Project → Settings → Environment Variables.
# Значения в репозиторий не коммитить.

# Токен бота от @BotFather, вида 1234567890:AA...
TELEGRAM_BOT_TOKEN=

# chat_id получателей заявок через запятую, без пробелов.
# Личка: положительное число (123456789). Группа: отрицательное (-1001234567890).
# Каждый получатель должен сначала написать боту /start (или бот должен быть добавлен в группу).
TELEGRAM_CHAT_IDS=

# Яндекс Метрика: номер счётчика для этого домена (только цифры). Пусто — Метрики и cookie-уведомления нет.
NEXT_PUBLIC_YM_ID=
